cabal-version:      3.4

-- Initial package description 'recycle-ics.cabal' generated by 'cabal init'.
-- For further documentation, see http://haskell.org/cabal/users-guide/

name:               recycle-ics
version:            0.2.0.0
synopsis:           Recycle ICS generator
description:
  Server and CLI tool to generate ICS files from the recycleapp.be API.

-- bug-reports:
license:            MIT
license-file:       LICENSE
author:             Brecht Serckx
maintainer:         services+git@brechtserckx.be
copyright:          (c) 2021-2022 Brecht Serckx
category:           Service
build-type:         Simple
extra-source-files: test/responses/*.json

-- Not 9.4.8 as in LTS, but highest current haskell-ci supports.
tested-with:        GHC ==9.4.5

common common-default-extensions
  default-language:   Haskell2010
  default-extensions:
    ApplicativeDo
    DataKinds
    DeriveAnyClass
    DeriveGeneric
    DerivingVia
    DuplicateRecordFields
    EmptyCase
    FlexibleContexts
    FlexibleInstances
    GADTs
    GeneralizedNewtypeDeriving
    InstanceSigs
    LambdaCase
    MultiParamTypeClasses
    MultiWayIf
    NamedFieldPuns
    NoFieldSelectors
    OverloadedRecordDot
    OverloadedStrings
    PackageImports
    PatternSynonyms
    RecordWildCards
    ScopedTypeVariables
    StandaloneDeriving
    StrictData
    TemplateHaskell
    TupleSections
    TypeApplications
    ViewPatterns

library
  import:          common-default-extensions
  hs-source-dirs:  src
  ghc-options:     -Wall
  exposed-modules:
    Recycle.API
    Recycle.AppM
    Recycle.Class
    Recycle.Ics.API
    Recycle.Ics.ICalendar
    Recycle.Ics.Server
    Recycle.Ics.Types
    Recycle.Types
    Recycle.Types.Error
    Recycle.Types.Geo
    Recycle.Types.LangCode
    Recycle.Utils

  other-modules:
    Paths_recycle_ics
    Recycle.Types.Orphans
    Servant.API.QueryParamForm

  autogen-modules: Paths_recycle_ics
  build-depends:
    , aeson
    , aeson-extra
    , base
    , bytestring
    , capability
    , case-insensitive
    , co-log
    , co-log-core
    , containers
    , data-default-class
    , deriving-aeson
    , exceptions
    , fast-logger
    , filepath
    , generic-lens
    , http-api-data
    , http-client
    , http-client-tls
    , http-media
    , http-types
    , iCalendar
    , mtl
    , optparse-applicative
    , retry
    , safe-exceptions
    , servant
    , servant-client
    , servant-server
    , sop-core
    , text
    , time
    , transformers
    , tz
    , wai
    , wai-app-static
    , wai-extra
    , warp

executable recycle-ics
  import:          common-default-extensions
  main-is:         Main.hs
  hs-source-dirs:  app
  other-modules:
    Opts
    Parsers
    Paths_recycle_ics

  autogen-modules: Paths_recycle_ics
  ghc-options:     -Wall -threaded -rtsopts -with-rtsopts=-N
  build-depends:
    , aeson
    , base
    , bytestring
    , co-log
    , co-log-core
    , filepath
    , http-client
    , http-client-tls
    , optparse-applicative
    , recycle-ics
    , servant-client
    , text
    , th-env
    , time
    , typed-process
    , tz
    , wai-cors
    , warp

test-suite recycle-ics-test
  import:         common-default-extensions
  type:           exitcode-stdio-1.0
  main-is:        Spec.hs
  hs-source-dirs: test
  ghc-options:    -threaded -rtsopts -with-rtsopts=-N
  build-depends:
    , aeson
    , aeson-extra
    , base
    , bytestring
    , containers
    , file-embed
    , hspec
    , QuickCheck
    , recycle-ics
    , text
    , time
    , vector

test-suite recycle-ics-api-test
  import:         common-default-extensions
  type:           exitcode-stdio-1.0
  main-is:        ApiSpec.hs
  hs-source-dirs: test-api
  ghc-options:    -threaded -rtsopts -with-rtsopts=-N
  build-depends:
    , base
    , co-log
    , co-log-core
    , hspec
    , http-client-tls
    , recycle-ics
    , servant-client
    , time
